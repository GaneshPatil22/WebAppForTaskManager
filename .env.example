# Copy to .env.local (gitignored) and fill in. Never commit real values.

# mock: in-memory fake server in the browser, no network, no sign-in (default).
# http: the real Brain server. Needs the two Supabase values below.
VITE_API_MODE=mock

# Where the Brain server lives. Empty means same origin; `npm run dev`
# proxies /v1 to http://127.0.0.1:8080.
VITE_API_BASE_URL=

# ---- Supabase auth (http mode only, ADR-0007) ----
# Project URL and the publishable (anon) key. Both are public by design;
# the server verifies tokens against the project's JWKS.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
